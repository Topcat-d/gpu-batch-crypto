{
  "kind": "illustrative_assumptions_not_measurements",
  "defaults": {
    "accesses_per_second": 100000,
    "fresh_fraction": 1.0,
    "accesses_per_credential": 1,
    "credential_use_fraction": 1.0,
    "compatible_groups": 1,
    "batch_size": 64,
    "fill_budget_ms": 1.0,
    "ready_jobs_per_group": 0
  },
  "scenarios": [
    {"name": "One authorized issuer, fresh credentials", "overrides": {}},
    {"name": "Same traffic across 100 trust/key groups", "overrides": {"compatible_groups": 100}},
    {"name": "90% credential reuse, one issuer", "overrides": {"fresh_fraction": 0.1}},
    {"name": "32-access books, fully consumed", "overrides": {"accesses_per_credential": 32}},
    {"name": "32-access books, quarter consumed", "overrides": {"accesses_per_credential": 32, "credential_use_fraction": 0.25}},
    {"name": "64 ready jobs per group, 100 groups", "overrides": {"compatible_groups": 100, "ready_jobs_per_group": 64}},
    {"name": "All access covered by reusable credentials", "overrides": {"fresh_fraction": 0.0}}
  ]
}
